{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": "outDir": "dist",
"rootDir": "src"
    "types": ["node", "@vercel/node"]
  },
  "include": ["src/**/*.ts"]
}
